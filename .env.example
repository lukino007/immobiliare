# Copy this file to .env and fill in your own values.
# The .env file is used by "netlify dev" for local development.
# In production, set the same variables in the Netlify UI:
# Project configuration > Environment variables.

# Password required to access the app.
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Use a long random string (32+ chars).
# Example: openssl rand -base64 48
SESSION_SECRET=change-me-with-a-long-random-string
